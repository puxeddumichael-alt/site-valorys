RewriteEngine On
# cabinet-valorys.com et l'ancienne adresse de test nouveau.cabinet-valorys.com -> www.cabinet-valorys.com
RewriteCond %{HTTP_HOST} ^(nouveau\.)?cabinet-valorys\.com$ [NC]
RewriteRule ^(.*)$ https://www.cabinet-valorys.com/$1 [L,R=301]
# Forcer HTTPS (sur l'adresse en cours : permet aussi de tester sur un sous-domaine)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Ancienne URL de l'ancien site
Redirect 301 /api/contact /contact.php

ErrorDocument 404 /404.html

# Compression et cache
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/webp "access plus 6 months"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType image/svg+xml "access plus 6 months"
</IfModule>

# Sécurité
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Types de fichiers
AddType image/avif .avif
AddType application/manifest+json .webmanifest
<IfModule mod_expires.c>
ExpiresByType image/avif "access plus 6 months"
ExpiresByType image/png "access plus 6 months"
</IfModule>

# Lien court à envoyer aux clients : cabinet-valorys.com/emprunteur
RewriteRule ^(emprunteur|assurance-emprunteur)/?$ /assurance-emprunteur.html [L]

# Fichiers internes du dépôt : jamais accessibles depuis internet
RedirectMatch 404 /\.git
RedirectMatch 404 ^/_source/
<FilesMatch "\.(md|py|gitignore)$">
  Require all denied
</FilesMatch>
